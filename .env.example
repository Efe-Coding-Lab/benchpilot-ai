# SQLite works with zero setup. For PostgreSQL, use the docker-compose URL below.
DATABASE_URL=sqlite:///./benchpilot.db
# DATABASE_URL=postgresql+psycopg://benchpilot:benchpilot@localhost:5432/benchpilot

# Optional local GenAI enhancement through Ollama.
BENCHPILOT_LLM=off
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
